# Public Sanity configuration
NEXT_PUBLIC_SANITY_PROJECT_ID=f46q2zdd
NEXT_PUBLIC_SANITY_DATASET=production

# Public analytics identifier (not a secret)
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Origin used to build newsletter confirmation links
SITE_URL=http://localhost:3000

# Resend newsletter configuration
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_NEWSLETTER_SEGMENT_ID=segment-id
RESEND_NEWSLETTER_TOPIC_ID=topic-id
NEWSLETTER_SIGNING_SECRET=replace-with-a-long-random-secret

# Contact-form SMTP configuration
SMTP_HOST=mail.example.org
SMTP_PORT=465
CONTACT_SMTP_USER=website@example.org
CONTACT_SMTP_PASSWORD=replace-with-mailbox-password
CONTACT_FROM_EMAIL=website@example.org
CONTACT_TO_EMAIL=info@example.org
